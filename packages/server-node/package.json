{
  "name": "@open-agent-docs/server",
  "version": "0.3.2",
  "description": "Run an Open Agent Docs server inside a Node process (Rust, napi-rs): start() returns { url, port, close() }, and it can be mounted on Node http / Express",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kadaliao/open-agent-docs.git",
    "directory": "packages/server-node"
  },
  "homepage": "https://github.com/kadaliao/open-agent-docs#readme",
  "bugs": "https://github.com/kadaliao/open-agent-docs/issues",
  "type": "module",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "*.node",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node scripts/build.mjs --release",
    "build:debug": "node scripts/build.mjs",
    "prepack": "node scripts/build.mjs --release",
    "test": "node scripts/build.mjs --if-missing && node --test 'test/*.test.mjs'"
  },
  "devDependencies": {
    "@open-agent-docs/client": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  }
}
