{
  "name": "@open-agent-docs/server",
  "version": "0.2.0",
  "description": "在 Node 进程里起 Open Agent Docs 服务器（Rust，napi-rs）：start() 返回 { url, port, close() }，还能挂到 Node http / Express 上",
  "license": "MIT",
  "type": "module",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "*.node",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node scripts/build.mjs --release",
    "build:debug": "node scripts/build.mjs",
    "prepack": "node scripts/build.mjs --release",
    "test": "node scripts/build.mjs --if-missing && node --test test/"
  },
  "devDependencies": {
    "@open-agent-docs/client": "workspace:*"
  }
}
