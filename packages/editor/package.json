{
  "name": "@open-agent-docs/editor",
  "version": "0.3.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "oad-source": "./src/index.ts",
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./database": {
      "oad-source": "./src/database/index.ts",
      "types": "./dist/types/database/index.d.ts",
      "import": "./dist/database.js"
    },
    "./schema": {
      "oad-source": "./src/schema/index.ts",
      "types": "./dist/types/schema/index.d.ts",
      "import": "./dist/schema.js"
    },
    "./i18n": {
      "oad-source": "./src/i18n.ts",
      "types": "./dist/types/i18n.d.ts",
      "import": "./dist/i18n.js"
    },
    "./resolve": {
      "oad-source": "./src/media/resolve.ts",
      "types": "./dist/types/media/resolve.d.ts",
      "import": "./dist/resolve.js"
    },
    "./style.css": {
      "oad-source": "./src/style.css",
      "types": "./dist/style.css.d.ts",
      "default": "./dist/style.css"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "*.css",
    "./src/database/index.ts",
    "./dist/database.js"
  ],
  "scripts": {
    "build": "rm -rf dist && vite build && tsc -p tsconfig.build.json && node scripts/clean-dts.mjs",
    "prepack": "pnpm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3",
    "@tiptap/core": "3.34.0",
    "@tiptap/extension-blockquote": "3.34.0",
    "@tiptap/extension-bold": "3.34.0",
    "@tiptap/extension-bubble-menu": "3.34.0",
    "@tiptap/extension-code": "3.34.0",
    "@tiptap/extension-code-block": "3.34.0",
    "@tiptap/extension-details": "3.34.0",
    "@tiptap/extension-document": "3.34.0",
    "@tiptap/extension-hard-break": "3.34.0",
    "@tiptap/extension-heading": "3.34.0",
    "@tiptap/extension-highlight": "3.34.0",
    "@tiptap/extension-horizontal-rule": "3.34.0",
    "@tiptap/extension-image": "3.34.0",
    "@tiptap/extension-italic": "3.34.0",
    "@tiptap/extension-link": "3.34.0",
    "@tiptap/extension-list": "3.34.0",
    "@tiptap/extension-paragraph": "3.34.0",
    "@tiptap/extension-strike": "3.34.0",
    "@tiptap/extension-text": "3.34.0",
    "@tiptap/extension-underline": "3.34.0",
    "@tiptap/extensions": "3.34.0",
    "@tiptap/pm": "3.34.0",
    "@tiptap/react": "3.34.0",
    "@tiptap/suggestion": "3.34.0",
    "blurhash": "^2.0.5",
    "katex": "^0.18.10",
    "mermaid": "^12.3.0",
    "shiki": "^4.6.0",
    "y-prosemirror": "^1.3.7",
    "y-protocols": "^1.0.7"
  },
  "peerDependencies": {
    "@open-agent-docs/client": "workspace:*",
    "react": "^19",
    "react-dom": "^19",
    "yjs": "^13.6"
  },
  "devDependencies": {
    "@open-agent-docs/client": "workspace:*",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "yjs": "^13.6.33"
  },
  "description": "Editor and components for Open Agent Docs: collaborative editor (Tiptap + Yjs), title, comments sidebar, database views and a useOadPage hook",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kadaliao/open-agent-docs.git",
    "directory": "packages/editor"
  },
  "homepage": "https://github.com/kadaliao/open-agent-docs#readme",
  "bugs": "https://github.com/kadaliao/open-agent-docs/issues",
  "module": "dist/index.js",
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  }
}
