{
  "name": "@open-agent-docs/markdown",
  "version": "0.2.0",
  "description": "oad-markdown 的 WASM 版：Markdown 和文档（ProseMirror JSON）互转、转只读 HTML（带 content.css），和服务器同一份代码",
  "type": "module",
  "main": "dist/oad_markdown.js",
  "module": "dist/oad_markdown.js",
  "types": "dist/oad_markdown.d.ts",
  "exports": {
    ".": {
      "types": "./dist/oad_markdown.d.ts",
      "default": "./dist/oad_markdown.js"
    },
    "./content.css": "./dist/content.css",
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "sh build.sh",
    "test": "cargo test -p oad-markdown --test wasm"
  },
  "license": "MIT"
}
