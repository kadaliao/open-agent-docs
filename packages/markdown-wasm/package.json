{
  "name": "@open-agent-docs/markdown",
  "version": "0.4.0",
  "description": "oad-markdown as WASM: Markdown <-> document (ProseMirror JSON), and document -> read-only HTML (with content.css), the same code as the server",
  "type": "module",
  "main": "dist/oad_markdown.js",
  "module": "dist/oad_markdown.js",
  "types": "dist/oad_markdown.d.ts",
  "exports": {
    ".": {
      "types": "./dist/oad_markdown.d.ts",
      "default": "./dist/oad_markdown.js"
    },
    "./content.css": "./dist/content.css",
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "sh build.sh",
    "test": "cargo test -p oad-markdown --test wasm"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kadaliao/open-agent-docs.git",
    "directory": "packages/markdown-wasm"
  },
  "homepage": "https://github.com/kadaliao/open-agent-docs#readme",
  "bugs": "https://github.com/kadaliao/open-agent-docs/issues",
  "publishConfig": {
    "access": "public"
  }
}
