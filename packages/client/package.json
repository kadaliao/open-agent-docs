{
  "name": "@open-agent-docs/client",
  "version": "0.3.0",
  "description": "Open Agent Docs 的 JS 客户端：HTTP 接口、实时事件、协作文档（Yjs）、本地数据库（WASM 引擎）。浏览器和 Node 18+ 都能用",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kadaliao/open-agent-docs.git",
    "directory": "packages/client"
  },
  "homepage": "https://github.com/kadaliao/open-agent-docs#readme",
  "bugs": "https://github.com/kadaliao/open-agent-docs/issues",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "oad-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "oad-source": "./src/core.ts",
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./page": {
      "oad-source": "./src/page.ts",
      "types": "./dist/page.d.ts",
      "import": "./dist/page.js"
    },
    "./db": {
      "oad-source": "./src/db/index.ts",
      "types": "./dist/db/index.d.ts",
      "import": "./dist/db/index.js"
    },
    "./node": {
      "oad-source": "./src/node.ts",
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": [
    "./src/page.ts",
    "./src/db/store.ts",
    "./dist/page.js",
    "./dist/db/store.js"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "pnpm run build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "gen:types": "node scripts/gen-types.mjs"
  },
  "dependencies": {
    "@open-agent-docs/db": "workspace:*",
    "y-indexeddb": "^9.0.12",
    "y-protocols": "^1.0.7",
    "y-websocket": "^3.1.0"
  },
  "peerDependencies": {
    "yjs": "^13.6"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/ws": "^8.5.12",
    "lib0": "^0.2.99",
    "openapi-typescript": "^7",
    "typescript": "^7.0.2",
    "typescript5": "npm:typescript@5.9.3",
    "vitest": "^5.1.1",
    "ws": "^8.18.0",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33"
  },
  "publishConfig": {
    "access": "public"
  }
}
