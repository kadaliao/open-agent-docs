{
  "name": "@open-agent-docs/migrate-legacy",
  "private": true,
  "type": "module",
  "description": "把旧版（Python）Open Agent Docs 的数据导进新版",
  "bin": {
    "oad-migrate-legacy": "./migrate.mjs"
  },
  "scripts": {
    "prepare-client": "pnpm --filter @open-agent-docs/client build",
