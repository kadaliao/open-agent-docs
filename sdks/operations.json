{
  "$comment": "各语言 SDK 的统一命名表：docs/openapi.json 里每个 operationId 在 SDK 里叫什么、返回值怎么整理。名字是 snake_case 的点路径（资源.子资源.方法），各语言按自己的习惯转（Python pages.versions.list，Go Pages.Versions.List，Rust pages().versions().list()）。服务器加了接口、这里没登记，node sdks/check-operations.mjs 会失败。字段见 docs/sdk-contract.md 的“命名表”。",
  "version": 1,
  "operations": {
    "auth_config": { "name": "auth.config" },
    "login": { "name": "auth.login" },
    "logout": { "name": "auth.logout" },
    "signup": { "name": "auth.signup" },

    "me": { "name": "me.get" },
    "update_me": { "name": "me.update" },
    "change_password": { "name": "me.change_password" },
    "my_notes": { "name": "me.notifications.list", "paginate": "notifications" },
    "read_my_notes": { "name": "me.notifications.mark_read" },

    "update_ws": { "name": "workspaces.update" },
    "members": { "name": "workspaces.members.list" },
    "set_role": { "name": "workspaces.members.set_role" },
    "remove_member": { "name": "workspaces.members.remove" },
    "events": { "name": "workspaces.events", "sse": "workspace" },
    "search": { "name": "search", "unwrap": "results" },

    "invite_info": { "name": "invites.get" },
    "accept": { "name": "invites.accept" },
    "list_invites": { "name": "invites.list", "unwrap": "invites" },
    "create_invite": { "name": "invites.create" },
    "revoke_invite": { "name": "invites.revoke" },

    "list_pages": { "name": "pages.list", "unwrap": "pages" },
    "create_page": { "name": "pages.create" },
    "get_page": { "name": "pages.get" },
    "patch_page": { "name": "pages.update" },
    "delete_page": { "name": "pages.delete" },
    "authors": { "name": "pages.authors", "unwrap": "clients" },
    "get_content": { "name": "pages.content.get" },
    "put_content": { "name": "pages.content.replace" },
    "insert_blocks": { "name": "pages.blocks.insert" },
    "get_block": { "name": "pages.blocks.get" },
    "put_block": { "name": "pages.blocks.replace" },
    "delete_block": { "name": "pages.blocks.delete" },
    "get_share": { "name": "pages.share.get", "null_on_404": true },
    "put_share": { "name": "pages.share.enable" },
    "del_share": { "name": "pages.share.disable" },
    "history_list": { "name": "pages.versions.list", "paginate": "versions" },
    "save": { "name": "pages.versions.create" },
    "one": { "name": "pages.versions.get" },
    "diff": { "name": "pages.versions.diff" },
    "history_restore": { "name": "pages.versions.restore" },

    "list_comments": { "name": "threads.list", "unwrap": "threads" },
    "create_thread": { "name": "threads.create" },
    "patch_thread": { "name": "threads.update" },
    "reply": { "name": "threads.reply" },
    "edit_comment": { "name": "comments.update" },
    "delete_comment": { "name": "comments.delete" },

    "create": { "name": "databases.create" },
    "import": { "name": "databases.import_csv", "upload": "csv" },
    "info": { "name": "databases.get" },
    "query": { "name": "databases.query" },
    "export": { "name": "databases.export_csv", "download": true },
    "press": { "name": "databases.press_button" },
    "rows": { "name": "databases.rows.list" },
    "add_rows": { "name": "databases.rows.add" },
    "patch_rows": { "name": "databases.rows.update" },
    "delete_rows": { "name": "databases.rows.delete" },
    "delete_one": { "name": "databases.rows.delete_one" },
    "change_schema": { "name": "databases.schema.update" },
    "undo_schema": { "name": "databases.schema.undo" },
    "add_view": { "name": "databases.views.create" },
    "put_views": { "name": "databases.views.replace", "unwrap": "views" },
    "patch_view": { "name": "databases.views.update" },
    "delete_view": { "name": "databases.views.delete" },
    "db_history": { "name": "databases.history.list", "paginate": "items" },
    "db_undo": { "name": "databases.history.undo" },

    "upload": { "name": "files.upload", "upload": "file" },
    "get_file_bare": { "name": "files.download", "download": true },
    "get_file": { "name": "files.download_named", "download": true },
    "get_media": { "name": "files.media", "download": true },
    "unfurl": { "name": "links.unfurl" },

    "trash_list": { "name": "trash.list", "paginate": "items" },
    "trash_restore": { "name": "trash.restore" },
    "purge": { "name": "trash.purge" },

    "list_agents": { "name": "agents.list", "unwrap": "agents" },
    "create_agent": { "name": "agents.create" },
    "update_agent": { "name": "agents.update" },
    "revoke_agent": { "name": "agents.revoke" },
    "rotate_token": { "name": "agents.rotate_token" },
    "rotate_secret": { "name": "agents.rotate_webhook_secret" },
    "poll_notes": { "name": "agent.notifications.list", "paginate": "notifications" },
    "ack_notes": { "name": "agent.notifications.ack" },
    "stream_notes": { "name": "agent.notifications.stream", "sse": "agent" }
  },
  "skip": {
    "handler": "协同编辑的 WebSocket（y-websocket 协议），只在 JS 的 @open-agent-docs/client（openPage）里有；别的语言读写正文用 pages.content"
  }
}
