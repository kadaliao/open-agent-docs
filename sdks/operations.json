{
  "$comment": "各语言 SDK 的统一命名表：docs/openapi.json 里每个 operationId 在 SDK 里叫什么、返回值怎么整理。名字是 snake_case 的点路径（资源.子资源.方法），各语言按自己的习惯转（Python pages.versions.list，Go Pages.Versions.List，Rust pages().versions().list()）。服务器加了接口、这里没登记，node sdks/check-operations.mjs 会失败。字段见 docs/sdk-contract.md 的“命名表”。",
  "version": 1,
  "operations": {
    "auth_config": { "name": "auth.config", "js": "authConfig" },
    "login": { "name": "auth.login", "js": "login" },
    "logout": { "name": "auth.logout", "js": "logout" },
    "signup": { "name": "auth.signup", "js": "signup" },

    "me": { "name": "me.get", "js": "me" },
    "update_me": { "name": "me.update", "js": "patchMe" },
    "change_password": { "name": "me.change_password", "js": "changePassword" },
    "my_notes": { "name": "me.notifications.list", "paginate": "notifications", "js": "inbox" },
    "read_my_notes": { "name": "me.notifications.mark_read", "js": "markRead" },

    "update_ws": { "name": "workspaces.update", "js": "patchWorkspace" },
    "members": { "name": "workspaces.members.list", "js": "members" },
    "set_role": { "name": "workspaces.members.set_role", "js": "patchMember" },
    "remove_member": { "name": "workspaces.members.remove", "js": "removeMember" },
    "events": { "name": "workspaces.events", "sse": "workspace", "js": "events" },
    "search": { "name": "search", "unwrap": "results", "js": "search" },

    "invite_info": { "name": "invites.get", "js": "inviteInfo" },
    "accept": { "name": "invites.accept", "js": "acceptInvite" },
    "list_invites": { "name": "invites.list", "unwrap": "invites", "js": "invites" },
    "create_invite": { "name": "invites.create", "js": "createInvite" },
    "revoke_invite": { "name": "invites.revoke", "js": "deleteInvite" },

    "list_pages": { "name": "pages.list", "unwrap": "pages", "js": "pages" },
    "create_page": { "name": "pages.create", "js": "createPage" },
    "get_page": { "name": "pages.get", "js": "page" },
    "patch_page": { "name": "pages.update", "js": "patchPage" },
    "delete_page": { "name": "pages.delete", "js": "deletePage" },
    "authors": { "name": "pages.authors", "unwrap": "clients", "js": "authors" },
    "get_content": { "name": "pages.content.get", "js": "content" },
    "put_content": { "name": "pages.content.replace", "js": "putContent" },
    "insert_blocks": { "name": "pages.blocks.insert", "js": "insertBlocks" },
    "get_block": { "name": "pages.blocks.get", "js": "block" },
    "put_block": { "name": "pages.blocks.replace", "js": "putBlock" },
    "delete_block": { "name": "pages.blocks.delete", "js": "deleteBlock" },
    "get_share": { "name": "pages.share.get", "null_on_404": true, "js": "getShare" },
    "put_share": { "name": "pages.share.enable", "js": "createShare" },
    "del_share": { "name": "pages.share.disable", "js": "revokeShare" },
    "history_list": { "name": "pages.versions.list", "paginate": "versions", "js": "versions" },
    "save": { "name": "pages.versions.create", "js": "saveVersion" },
    "one": { "name": "pages.versions.get", "js": "version" },
    "diff": { "name": "pages.versions.diff", "js": "versionDiff" },
    "history_restore": { "name": "pages.versions.restore", "js": "restoreVersion" },

    "list_comments": { "name": "threads.list", "unwrap": "threads", "js": "threads" },
    "create_thread": { "name": "threads.create", "js": "createThread" },
    "patch_thread": { "name": "threads.update", "js": "resolveThread" },
    "reply": { "name": "threads.reply", "js": "reply" },
    "edit_comment": { "name": "comments.update", "js": "editComment" },
    "delete_comment": { "name": "comments.delete", "js": "deleteComment" },

    "create": { "name": "databases.create", "js": "createDatabase" },
    "import": { "name": "databases.import_csv", "upload": "csv", "js": "importCsv" },
    "info": { "name": "databases.get", "js": "getDatabase" },
    "query": { "name": "databases.query", "js": "queryDatabase" },
    "export": { "name": "databases.export_csv", "download": true, "js": "exportCsv" },
    "press": { "name": "databases.press_button", "js": "pressButton" },
    "rows": { "name": "databases.rows.list", "js": "dbRows" },
    "add_rows": { "name": "databases.rows.add", "js": "addRows" },
    "patch_rows": { "name": "databases.rows.update", "js": "patchRows" },
    "delete_rows": { "name": "databases.rows.delete", "js": "deleteRows" },
    "delete_one": { "name": "databases.rows.delete_one", "js": "deleteRow" },
    "change_schema": { "name": "databases.schema.update", "js": "patchSchema" },
    "undo_schema": { "name": "databases.schema.undo", "js": "undoSchema" },
    "add_view": { "name": "databases.views.create", "js": "addView" },
    "put_views": { "name": "databases.views.replace", "unwrap": "views", "js": "putViews" },
    "patch_view": { "name": "databases.views.update", "js": "patchView" },
    "delete_view": { "name": "databases.views.delete", "js": "deleteView" },
    "db_history": { "name": "databases.history.list", "paginate": "items", "js": "dbHistory" },
    "db_undo": { "name": "databases.history.undo", "js": "dbUndo" },

    "upload": { "name": "files.upload", "upload": "file", "js": "upload" },
    "get_file_bare": { "name": "files.download", "download": true, "js": "download" },
    "get_file": { "name": "files.download_named", "download": true, "js": "downloadNamed" },
    "get_media": { "name": "files.media", "download": true, "js": "media" },
    "sign_files": { "name": "files.sign", "js": "signFileUrls" },
    "unfurl": { "name": "links.unfurl", "js": "unfurl" },

    "trash_list": { "name": "trash.list", "paginate": "items", "js": "trash" },
    "trash_restore": { "name": "trash.restore", "js": "restoreTrash" },
    "purge": { "name": "trash.purge", "js": "purgeTrash" },

    "list_agents": { "name": "agents.list", "unwrap": "agents", "js": "agents" },
    "create_agent": { "name": "agents.create", "js": "createAgent" },
    "update_agent": { "name": "agents.update", "js": "patchAgent" },
    "revoke_agent": { "name": "agents.revoke", "js": "revokeAgent" },
    "rotate_token": { "name": "agents.rotate_token", "js": "reissueToken" },
    "rotate_secret": { "name": "agents.rotate_webhook_secret", "js": "reissueWebhookSecret" },
    "poll_notes": { "name": "agent.notifications.list", "paginate": "notifications", "js": "agentNotifications" },
    "ack_notes": { "name": "agent.notifications.ack", "js": "ackAgentNotifications" },
    "stream_notes": { "name": "agent.notifications.stream", "sse": "agent", "js": "agentEvents" }
  },
  "skip": {
    "handler": "协同编辑的 WebSocket（y-websocket 协议），只在 JS 的 @open-agent-docs/client（openPage）里有；别的语言读写正文用 pages.content"
  }
}
